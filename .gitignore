# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# ComfyUI specific
input/
output/
temp/
*.log

# Cache directories
.cache/
**/.cache/

# Models and large files (never commit these large files)
models/
*.safetensors
*.ckpt
*.gguf
*.bin
*.pt
*.pth

# Credentials (never commit these)
credentials/
.env
*.token
workspace/.civitai_token
workspace/.huggingface_token
workspace/.hf_token

# One-off migrations / scratch scripts (not part of supported repo tooling)
workspace/ephemera/
# Runtime mirror of docs/family_discovery for the container (until ./docs is mounted).
workspace/family_discovery/

# Workspace runtime / local state
workspace/_tmp/
workspace/output/
workspace/input/
workspace/comfyui_user/
workspace/ComfyUI
workspace/comfyui-wan

# .data/ is mostly local runtime — ignore by default, then allowlist factory defs.
.data/**
!.data/shapes/
!.data/shapes/**
!.data/pools/
!.data/pools/*/
!.data/pools/*/pools.yaml
!.data/pools/*/prompts/
!.data/pools/*/prompts/catalog-default.json
!.data/pipelines/
!.data/pipelines/**
!.data/chains/
!.data/chains/**
!.data/WORKFLOW_FACTORY_NEXT.md

# Still never track pool runtime / derived indexes under the allowlisted dirs
.data/pools/*/index.json
.data/pools/*/prompts/_replay/
.data/pools/*/prompts/_replay/**

# SFTP (output-sftp): persisted SSH host keys — never commit
.data/output-sftp-ssh-hostkeys/

# Docker
.dockerignore

# Node.js (if any)
node_modules/
npm-debug.log*

# Experiments UI build output (served at runtime)
workspace/experiments_ui/dist/

# TypeScript incremental build cache (Vite/tsc)
*.tsbuildinfo

# Local scratch logs (repo root)
/tmp_comfy_logs.txt

# MkDocs planning docs build output
site/
.venv-docs/

# Workspace vendored custom nodes (cloned beside repo bootstrap; do not track)
workspace/ComfyUI-*/

# Custom nodes git directories (we don't want to track these as submodules)
**/.git/
custom_nodes/**/.git
workspace/**/.git

# Custom nodes (cloned by bootstrap from custom_nodes.yaml; do not track)
custom_nodes/
ComfyUI-Custom-Scripts/
